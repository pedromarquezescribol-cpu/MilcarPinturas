---
import { SITE, footerGroups } from '../../config/site';
---

<footer class="border-t-4 border-brand-deep bg-neutral-900 text-white">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3 lg:px-8">
		<div>
			<p class="text-2xl font-black tracking-tight">pinterex<span class="text-brand">.</span></p>
			<p class="mt-1 text-xs font-black uppercase tracking-widest text-brand">Una marca de {SITE.parent}</p>
			<p class="mt-2 max-w-xs text-sm leading-6 text-neutral-300">
				Pinturas para tela y para otras superficies.
			</p>
		</div>

		{
			footerGroups.map((group) => (
				<div>
					<h2 class="text-sm font-black uppercase tracking-widest text-brand">{group.title}</h2>
					<ul class="mt-3 space-y-2 text-sm text-neutral-300">
						{group.links.map((link) => (
							<li>
								<a class="transition hover:text-white" href={link.href}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	<div class="border-t border-white/10 px-4 py-6 text-center text-xs text-neutral-400 sm:px-6 lg:px-8">
		© {SITE.year} {SITE.name}, una marca de {SITE.parent}. Todos los derechos reservados.
	</div>
</footer>
