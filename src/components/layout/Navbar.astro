---
import milcarLogo from '../../assets/logos/logomilcar.png';
import pinterexLogo from '../../assets/logos/logo-pinterex.webp';
import { SITE, navLinks } from '../../config/site';
import { isActivePath } from '../../lib/navigation';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b-2 border-brand-deep/30 bg-brand shadow-lg shadow-black/5">
	<nav
		class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6 lg:px-8"
		aria-label="Navegación principal"
	>
		<a
			href={SITE.routes.home}
			class="flex items-center gap-2.5 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-black/60 sm:gap-3"
			aria-label={`${SITE.parent} y ${SITE.name} - Inicio`}
		>
			<img
				src={milcarLogo.src}
				width={milcarLogo.width}
				height={milcarLogo.height}
				alt={SITE.parent}
				class="h-8 w-auto shrink-0 sm:h-9"
			/>
			<span class="h-7 w-px shrink-0 bg-brand-deep/40 sm:h-8" aria-hidden="true"></span>
			<img
				src={pinterexLogo.src}
				width={pinterexLogo.width}
				height={pinterexLogo.height}
				alt={SITE.name}
				class="h-10 w-auto shrink-0 drop-shadow-sm sm:h-12"
			/>
		</a>

		<ul class="flex items-center gap-1 sm:gap-2">
			{
				navLinks.map(({ href, label }) => {
					const isActive = isActivePath(currentPath, href);

					return (
						<li>
							<a
								href={href}
								aria-current={isActive ? 'page' : undefined}
								class:list={[
									'block rounded-full px-4 py-2 text-sm font-extrabold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-black/60 sm:text-base',
									isActive
										? 'bg-neutral-900 text-white shadow-md'
										: 'text-neutral-900/80 hover:bg-white/50 hover:text-neutral-900',
								]}
							>
								{label}
							</a>
						</li>
					);
				})
			}
		</ul>
	</nav>
</header>
