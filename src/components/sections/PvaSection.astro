---
import type { PvaIntro, PvaProduct } from '../../types/content';
import Badge from '../ui/Badge.astro';
import Photo from '../ui/Photo.astro';

interface Props {
	intro: PvaIntro;
	products: PvaProduct[];
}

const { intro, products } = Astro.props;
---

<section id="pva" class="scroll-mt-40 relative overflow-hidden bg-brand-deep py-16 text-white sm:py-20">
	<div class="absolute -left-20 top-10 h-72 w-72 rounded-full bg-brand/40 blur-3xl" aria-hidden="true"></div>

	<div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-center">
			<div>
				<Badge variant="light">Otras superficies</Badge>
				<h2 class="mt-4 text-3xl font-black leading-tight tracking-tight sm:text-4xl lg:text-5xl">
					{intro.title}
				</h2>
				<p class="mt-4 text-lg leading-8 text-white/90">{intro.description}</p>
			</div>
			<div>
				<Photo src={intro.image} alt={intro.imageAlt} aspect="16/10" frame="glass" />
			</div>
		</div>

		<div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
			{
				products.map((product) => (
					<article class="overflow-hidden rounded-3xl bg-white text-neutral-900 shadow-xl">
						<div class="aspect-[4/3] overflow-hidden">
							<Photo src={product.image} alt={product.alt} aspect="4/3" class="h-full" />
						</div>
						<div class="p-5">
							<Badge variant="deep">{product.bestFor}</Badge>
							<h3 class="mt-3 text-lg font-black">{product.name}</h3>
							<p class="mt-1 text-sm leading-6 text-neutral-600">{product.description}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
