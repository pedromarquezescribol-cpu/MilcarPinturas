---
import type { FaqItem } from '../../types/content';

interface Props {
	items: FaqItem[];
}

const { items } = Astro.props;
---

<section id="preguntas" class="scroll-mt-40 bg-white py-16 sm:py-20">
	<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl font-black tracking-tight sm:text-4xl">Preguntas frecuentes</h2>

		<div class="mt-8 grid gap-3">
			{
				items.map((item) => (
					<details data-smooth class="group rounded-2xl border-2 border-brand-soft bg-brand-soft/20 p-5 [&::-webkit-details-marker]:hidden">
						<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-black focus:outline-none">
							<span>{item.question}</span>
							<svg
								class="h-5 w-5 shrink-0 text-brand-deep transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
								viewBox="0 0 20 20"
								fill="currentColor"
								aria-hidden="true"
							>
								<path
									fill-rule="evenodd"
									d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z"
									clip-rule="evenodd"
								/>
							</svg>
						</summary>
						<p class="mt-3 border-t-2 border-brand-soft pt-3 leading-7 text-neutral-600">
							{item.answer}
						</p>
					</details>
				))
			}
		</div>
	</div>
</section>
