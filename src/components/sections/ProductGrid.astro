---
import type { TextileProduct } from '../../types/content';
import ProductCard from './ProductCard.astro';

interface Props {
	products: TextileProduct[];
}

const { products } = Astro.props;
const featured = products.filter((product) => product.featured);
const others = products.filter((product) => !product.featured);
---

<section id="productos" class="scroll-mt-40 bg-white py-16 sm:py-20">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl font-black tracking-tight sm:text-4xl">{products.length} productos para tela</h2>
		<p class="mt-2 max-w-2xl leading-7 text-neutral-600">
			Uno da el color. Los demás te ayudan a preparar, fijar y crear efectos.
		</p>

		{
			featured.length > 0 && (
				<div class="mt-8 grid gap-6 rounded-3xl border-4 border-brand bg-brand-soft/30 p-4 lg:p-6">
					{featured.map((product) => (
						<ProductCard product={product} featured />
					))}
				</div>
			)
		}

		<div class="mt-6 grid gap-6 sm:grid-cols-2">
			{others.map((product) => <ProductCard product={product} />)}
		</div>
	</div>
</section>
