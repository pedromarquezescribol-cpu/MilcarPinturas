---
import type { StepCard } from '../../types/content';
import Photo from '../ui/Photo.astro';

interface Props {
	steps: StepCard[];
	title: string;
	note?: string;
	id?: string;
	sectionClass?: string;
}

const {
	steps,
	title,
	note,
	id,
	sectionClass = 'bg-brand-soft/50 py-16 sm:py-20',
} = Astro.props;
---

<section id={id} class:list={['scroll-mt-40', sectionClass]}>
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<h2 class="text-3xl font-black tracking-tight sm:text-4xl">{title}</h2>

		<div class="mt-8 grid gap-5 md:grid-cols-3">
			{
				steps.map((step, index) => (
					<article class="overflow-hidden rounded-3xl border-2 border-white bg-white shadow-md">
						<div class="aspect-[4/3] overflow-hidden">
							<Photo src={step.image} alt={step.alt} aspect="4/3" />
						</div>
						<div class="p-6">
							<span class="text-xs font-black tracking-widest text-brand-deep">
								PASO {String(index + 1).padStart(2, '0')}
							</span>
							<h3 class="mt-1 text-xl font-black">{step.title}</h3>
							<p class="mt-2 leading-7 text-neutral-600">{step.text}</p>
						</div>
					</article>
				))
			}
		</div>

		{note && <p class="mt-6 text-center text-sm font-bold text-neutral-600">{note}</p>}
	</div>
</section>
